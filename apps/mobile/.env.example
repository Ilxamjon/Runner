# Runner environment: development | staging | production
APP_ENV=development

# Expo / EAS project id (set for cloud preview/staging builds)
EAS_PROJECT_ID=

# Supabase (required for mobile app)
# Keep staging and production projects separate.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Maps API key for Android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
